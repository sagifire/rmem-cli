{
    "name": "rmem-cli-workspace",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "npm run build && node --test dist-tests/*.test.js",
        "check": "npm run build && npm run test",
        "pack:dry-run": "npm pack --workspaces --dry-run",
        "smoke:real-models": "powershell -ExecutionPolicy Bypass -File tools/manual-real-model-smoke.ps1"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "typescript": "^5.8.3"
    }
}
