{
    "name": "rmem-cli-workspace",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/sagifire/rmem-cli"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "npm run build && node --test dist-tests/*.test.js",
        "check": "npm run test && npm run smoke:package && npm run pack:dry-run",
        "pack:dry-run": "node tools/package-dry-run.mjs",
        "smoke:package": "node tools/package-install-smoke.mjs",
        "smoke:real-models": "powershell -ExecutionPolicy Bypass -File tools/manual-real-model-smoke.ps1"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "typescript": "^5.8.3"
    }
}
